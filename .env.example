# PostgreSQL (Neon: create a project, click Connect, copy the pooled connection string)
DATABASE_URL=

# Clerk (Dashboard > Configure > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk (Dashboard > Webhooks > Add endpoint; URL: /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# KeeperHub organization key (Settings > API Keys > Organisation; must start kh_)
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
